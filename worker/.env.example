# Copy to worker/.env (git-ignored) and fill in. Real environment variables win over this file.

# Brave Search API key. Easier: paste it on Quire's Settings page, which wins over this line. See README.md.
BRAVE_API_KEY=

# Web searches one check may spend (40 if unset). 10 makes Brave's monthly free credit (about 1,000 searches)
# last for about 100 checks; more finds more sources.
SEARCH_QUERY_BUDGET=10

# The reference list's titles are looked up in OpenAlex and Crossref (free, no key). off: they aren't sent.
REFERENCE_LOOKUP=

# Optional contact (email or URL) added to the fetcher's User-Agent; Wikipedia asks bots for one.
UA_CONTACT=

# Optional. Leave empty for data/quire.db at the project root.
DATABASE_PATH=

# AI writing estimate: classifier or binoculars. Empty means the classifier once one is trained
# (calibration/train_classifier.py writes data/calibration/classifier/model), Binoculars until then.
AI_DETECTOR=
AI_DEVICE=

# The classifier: a ModernBERT-base fine-tuned on this PC. Its threshold and rates come from
# calibration/eval_classifier.py (the "mixed threshold" line); until then it is marked uncalibrated.
AI_CLASSIFIER=
AI_CLASSIFIER_THRESHOLD=
AI_CLASSIFIER_FALSE_POSITIVE_RATE=
AI_CLASSIFIER_DETECTION_RATE=

# Binoculars. Defaults: the Qwen2.5-1.5B pair, on the GPU when there is one.
# AI_THRESHOLD and the two rates come from calibrate_ai.py; until then the estimate is
# marked uncalibrated.
AI_OBSERVER=
AI_PERFORMER=
AI_THRESHOLD=
AI_FALSE_POSITIVE_RATE=
AI_DETECTION_RATE=

# Calibration only (T12): OpenRouter writes the AI comparison essays from the PERSUADE prompts.
# Your drafts are never sent. Free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: comma-separated free models to use instead of the defaults in calibration/generate_ai.py.
AI_CALIBRATION_MODELS=
# Calibration only: calibration/generate_nvidia.py (the classifier's current-model essays) and the
# calibration/judge_ai.py experiment, on NVIDIA's free API. Drafts are never sent. https://build.nvidia.com
NVIDIA_API_KEY=
